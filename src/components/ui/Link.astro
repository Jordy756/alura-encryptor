---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary-btn' | 'secondary-btn';
}

const { variant = 'primary-btn', class: className, ...props } = Astro.props;
---

<a
  class:list={[
    'rounded-sm border px-5.75 py-2.75 text-center font-semibold transition-[background-color,border-color,opacity] duration-300 ease-in-out disabled:cursor-not-allowed disabled:opacity-60',
    variant,
    className,
  ]}
  {...props}
>
  <slot />
</a>
