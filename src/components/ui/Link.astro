---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "secondary";
}

const { variant = "primary", class: className, ...props } = Astro.props;
---

<a
  class:list={[
    "flex items-center justify-center gap-2 rounded-sm border px-7.75 py-3.75 text-center font-semibold duration-300 ease-in-out disabled:cursor-not-allowed disabled:opacity-60",
    `btn-${variant}`,
    className,
  ]}
  {...props}
>
  <slot />
</a>
