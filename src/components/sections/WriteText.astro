---
import Button from "@components/ui/Button.astro";
import WarningIcon from "@components/icons/Warning.astro";
---

<section class="write-text-section">
  <div class="input-text-container">
    <label for="input-text">Texto de entrada</label>
    <textarea id="input-text" placeholder="Ingresa el texto a encriptar o desencriptar"></textarea>
  </div>
  <span>
    <WarningIcon class="w-5 h-5" />
    Solo letras minúsculas y sin acento
  </span>
  <div class="buttons-container">
    <Button id="btn-encrypt">Encriptar</Button>
    <Button id="btn-decrypt" variant="secondary">Desencriptar</Button>
  </div>
</section>

<style>
  .write-text-section {
    flex: 3 250px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .write-text-section > .input-text-container {
    flex: 1;
    position: relative;
  }

  .write-text-section > .input-text-container > label {
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }

  .write-text-section > .input-text-container > textarea {
    width: 100%;
    height: 100%;
    min-height: 300px;
    padding: 1rem;
    border: none;
    resize: none;
    outline: none;
    border-radius: var(--border-radius-out);
  }

  .write-text-section > span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1;
    font-size: 0.875rem;
  }

  .write-text-section > .buttons-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>

