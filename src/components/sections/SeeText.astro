---
import CopyIcon from '@components/icons/Copy.astro';
import Button from '@components/ui/Button.astro';
import DocumentIcon from '@components/icons/Document.astro';
---

<section
  class="relative flex min-h-100 flex-[1_1_250px] flex-col gap-4 overflow-hidden rounded-sm border border-neutral-200 bg-neutral-100 p-4 transition-[border-color,background-color] duration-300 ease-in-out dark:border-neutral-800 dark:bg-neutral-900 [&>#output-text:empty~button]:pointer-events-none [&>#output-text:empty~button]:hidden [&>#output-text:empty~button]:opacity-0 [&>#output-text:not(:empty)+div]:hidden [&>#output-text:not(:empty)+div]:opacity-0"
>
  <span
    id="output-text"
    class="hidden wrap-anywhere opacity-0 transition-[opacity,display] transition-discrete duration-300 ease-in-out not-empty:block not-empty:opacity-100"
  ></span>
  <div
    class="flex flex-1 flex-col items-center justify-center gap-2 text-center transition-[opacity,display] transition-discrete duration-300 ease-in-out"
  >
    <figure class="flex size-24 items-center justify-center rounded-full bg-primary-500/10 text-primary-500">
      <DocumentIcon class="size-16" />
    </figure>
    <h2 class="text-2xl">Ningún mensaje fue encontrado</h2>
    <p>Ingresa el texto que desees encriptar o desencriptar.</p>
  </div>
  <Button
    id="btn-copy-to-clipboard"
    class="mt-auto flex-none rounded-xs transition-[background-color,border-color,opacity] duration-300 ease-in-out [&.success]:border-green-500 [&.success]:bg-green-500"
  >
    <CopyIcon class="size-6" />
    <span>Copiar</span>
  </Button>
</section>

<script src="../../scripts/lib/seeText.ts"></script>
