---
import CopyIcon from "@components/icons/Copy.astro";
import Button from "@components/ui/Button.astro";
import DocumentIcon from "@components/icons/Document.astro";
---

<section class="see-text-section">
  <span id="output-text"></span>
  <div>
    <figure>
      <DocumentIcon class="h-16 w-16" />
    </figure>
    <h2>Ningún mensaje fue encontrado</h2>
    <p>Ingresa el texto que desees encriptar o desencriptar.</p>
  </div>
  <Button id="btn-copy-to-clipboard">
    <CopyIcon />
    <span>Copiar</span>
  </Button>
</section>

<style>
  .see-text-section {
    flex: 1 250px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    min-height: 400px;
    border-radius: var(--border-radius-out);
    background-color: light-dark(var(--neutral-100), var(--neutral-800));
    border: 1px solid light-dark(var(--neutral-200), var(--neutral-700));
    overflow: hidden;
    transition:
      border-color var(--transition-theme),
      background-color var(--transition-theme);
  }

  .see-text-section > span {
    display: none;
    overflow-wrap: anywhere;
    opacity: 0;
  }

  .see-text-section > span,
  .see-text-section > div {
    transition:
      opacity 0.3s ease-in-out,
      display 0.3s ease-in-out allow-discrete;
  }

  .see-text-section > span:not(:empty) {
    display: block;
    opacity: 1;
  }

  .see-text-section > div {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .see-text-section > span:not(:empty) + div {
    opacity: 0;
    display: none;
  }

  .see-text-section > div > figure {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 96px;
    height: 96px;
    color: var(--primary-500);
    background-color: #ea4c891a;
    border-radius: 9999999px;
  }

  .see-text-section > div > h2 {
    font-size: var(--text-size-medium);
  }

  .see-text-section > :global(button.primary) {
    flex: none;
    margin-top: auto;
    border-radius: var(--border-radius-in);
    display: flex;
    transition:
      opacity 0.3s ease-in-out,
      background-color 0.3s ease-in-out,
      display 0.3s ease-in-out allow-discrete;
  }

  .see-text-section > :global(button.primary.success) {
    background-color: var(--success-500);
  }

  .see-text-section > span:empty ~ :global(button.primary) {
    opacity: 0;
    display: none;
    pointer-events: none;
  }

  @starting-style {
    .see-text-section > span:not(:empty),
    .see-text-section > div,
    .see-text-section > :global(button.primary) {
      opacity: 0;
    }
  }
</style>

