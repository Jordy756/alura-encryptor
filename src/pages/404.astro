---
import Footer from '@components/shell/Footer.astro';
import Header from '@components/shell/Header.astro';
import Link from '@components/ui/Link.astro';
import Layout from '@layouts/Layout.astro';

const title = '404 - Página no encontrada';
const description = 'Lo sentimos, la página que buscas no existe.';
---

<Layout title={title} description={description}>
  <Header />
  <main class="relative flex flex-1 flex-col items-center justify-center gap-8 overflow-clip p-4">
    <h1
      class="absolute -z-10 -rotate-25 text-[clamp(4rem,50vw+1rem,50rem)] text-neutral-200 transition-[color] duration-300 ease-in-out dark:text-neutral-800"
    >
      404
    </h1>
    <div class="flex flex-col items-center gap-2 text-center">
      <h2 class="text-3xl">Página no encontrada</h2>
      <p>Lo sentimos, la página que buscas no existe.</p>
    </div>
    <Link href="/">Volver al inicio</Link>
  </main>
  <Footer />
</Layout>
