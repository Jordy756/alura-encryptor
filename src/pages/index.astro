---
import Footer from "@components/layout/Footer.astro";
import Header from "@components/layout/Header.astro";
import Layout from "@layouts/Layout.astro";
import SeeText from "@components/sections/SeeText.astro";
import WriteText from "@components/sections/WriteText.astro";

const title = "Alura Encryptor - Encriptador de textos";
const description =
  "Encripta y desencripta mensajes fácilmente con AluEncrypt. Un desafío del programa Oracle Next Education (ONE) y Alura Latam.";
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <WriteText />
    <SeeText />
  </main>
  <Footer />
</Layout>

<style>
  main {
    flex: 1;
    align-self: center;
    padding: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    width: min(calc(var(--max-width) + 2rem), 100%);
  }
</style>
