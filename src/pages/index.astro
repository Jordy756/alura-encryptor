---
import SeeText from '@components/sections/SeeText.astro';
import WriteText from '@components/sections/WriteText.astro';
import Footer from '@components/shell/Footer.astro';
import Header from '@components/shell/Header.astro';
import Layout from '@layouts/Layout.astro';

const title = 'Alura Encryptor - Encriptador de textos';
const description =
  'Encripta y desencripta mensajes fácilmente con AluEncrypt. Un desafío del programa Oracle Next Education (ONE) y Alura Latam.';
---

<Layout title={title} description={description}>
  <Header />
  <main class="mx-auto flex w-[min(calc(var(--max-width)+2rem),100%)] flex-1 flex-wrap gap-12 p-4">
    <WriteText />
    <SeeText />
  </main>
  <Footer />
</Layout>
